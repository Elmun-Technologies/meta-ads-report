# ============================================================================
# Google Ads API integratsiyasi — namunaviy environment (Variant A: pull+commit)
# Bu faylni .env deb nomlab ko'chiring va maxfiy qiymatlarni to'ldiring.
# .env gitignore'da — hech qachon commit qilmang!
#
# To'liq qo'llanma: docs/google-ads-api-setup.md
# ============================================================================

# 1-qadam: Google Cloud Console → OAuth client (docs 1-qadam)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# 2-qadam: MCC → API Center → developer token (docs 2-qadam)
# Dastlab "Test access"; real hisob uchun Google tasdiqlashi kerak.
GOOGLE_ADS_DEVELOPER_TOKEN=

# 3-qadam: OAuth ruxsat → refresh token (pnpm google:oauth)
GOOGLE_ADS_REFRESH_TOKEN=

# Menedjer (MCC) customer id — "login-customer-id". Raqamlarsiz (123-456-7890 → 1234567890)
GOOGLE_ADS_MANAGER_ID=

# Analitika kerak bo'lgan customer id(lar), vergul bilan:
GOOGLE_ADS_CUSTOMER_IDS=

# Test rejimda true — shunda faqat test MCC ishlaydi (token tasdiqlanmasa ham)
GOOGLE_ADS_USE_TEST_ACCOUNT=false

# (Ixtiyoriy)
GOOGLE_ADS_DATE_RANGE=LAST_30_DAYS
GOOGLE_ADS_CURRENCY=USD
# GOOGLE_ADS_API_VERSION=v25

# ============================================================================
# OAuth — o'z hisoblaringizni "Ulash" tugmasi bilan bog'lash (V4.0)
# Ushbu app kalitlari BIR MARTA admin tomonidan sozlanadi — keyin har bir
# foydalanuvchi o'z Facebook/Google/AmoCRM hisobini UI'dan o'zi ulaydi.
# Tokenlar serverda (store.json) saqlanadi, client'ga yuborilmaydi.
#
# MUHIM: bu kalitlarni .env ga yozmasdan, Ulanishlar sahifasidagi «Sozlash»
# oynasidan ham kiritishingiz mumkin — server/data/store.json ga yoziladi va
# serverni qayta ishga tushirish SHART EMAS. Ikkala manba birlashtirilib o'qiladi
# (bo'sh qoldirilgan .env maydonlari UI'dagi qiymatni to'sib qo'ymaydi).
# App kalitlari bo'lmagan holda ham «Token bilan ulash» ishlaydi.
# ============================================================================

# Meta — developers.facebook.com → My Apps → yangi app (Business turi)
# Dialogga qo'shilgan redirect URL: https://<sizning-host>/api/oauth/meta/callback
#
# «Sozlash» oynasida App ID/Secret saqlanmayapti va «Server xatosi (404)» chiqyaptimi?
# Bu kalitlar noto'g'ri degani emas — /api/* ni ushlaydigan server ishlamayapti
# (sayt statik rejimda yoki server eski versiyada). Batafsil: README → «Server xatosi (404)».
META_APP_ID=
META_APP_SECRET=

# Google — Google Cloud Console → OAuth client (docs/google-ads-api-setup.md)
# Authorized redirect URI: https://<sizning-host>/api/oauth/google-ads/callback
# (GOOGLE_ADS_CLIENT_ID / GOOGLE_ADS_CLIENT_SECRET yuqoridagi Google bo'limda)

# AmoCRM — hisobingiz → Sozlamalar → Integratsiyalar → yangi integratsiya
# Redirect URI: https://<sizning-host>/api/oauth/amocrm/callback
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=

# ============================================================================
# Real-time sync dvigateli (server rejimi: Railway/Render/VPS yoki pnpm dev)
# ============================================================================

# Meta Ads — Graph API'dan to'g'ridan-to'g'ri tortish (MCP eksporti shart emas)
# Token: Meta Business Settings → System User → ads_read huquqi bilan
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=            # act_... yoki faqat raqamlar
META_DAYS=30                   # qancha kunlik davr (default 30)

# Telegram — TGStat API (kanal statistikasi)
# Token: tgstat.ru → Личный кабинет (my/profile) → API token (muddatsiz).
# Bu qiymatni .env ga yozmasdan, Ulanishlar sahifasidagi «Telegram» kartasidan
# ham kiritishingiz mumkin — server tekshirib (usage/stat, tariflanmaydi) saqlaydi.
TGSTAT_TOKEN=

# Sync intervali (sekundda, minimum 30). Default 300 = 5 daqiqa
SYNC_INTERVAL_SEC=300

# Valyutalar (umumiy hisobda ko'rsatiladi)
AMOCRM_CURRENCY=UZS
OFFLINE_CURRENCY=UZS
TELEGRAM_CURRENCY=UZS

# ============================================================================
# Xavfsizlik (ixtiyoriy, lekin ochiq URL'da deploy qilsangiz — tavsiya etiladi)
# ============================================================================

# Dashboard paroli — qo'yilganda butun /api/* parol ostiga o'tadi (login ekrani).
# Bo'sh qoldirilsa: parol himoyasi o'chiriq (lokal dev uchun qulay).
DASHBOARD_PASSWORD=

# Sessiya imzosi uchun maxfiy kalit (random satr). Berilmasa paroldan hosil qilinadi —
# parol o'zgarsa barcha sessiyalar tugaydi.
AUTH_SECRET=

# AmoCRM webhook maxfiy kaliti — qo'yilganda webhook faqat ?secret=... bilan qabul qilinadi:
#   https://<host>/api/webhooks/amocrm?secret=<shu qiymat>
WEBHOOK_SECRET=

# ============================================================================
# Deploy sozlamalari (ixtiyoriy)
# ============================================================================

# Tashqi (browser ko'radigan) manzil — OAuth redirect URI shundan hosil qilinadi.
# Proxy/preview ortida ishlatganda ANIQ yozing, aks holda provider "redirect_uri
# mismatch" xatosini beradi. Bo'sh bo'lsa X-Forwarded-Host/Proto dan olinadi.
PUBLIC_ORIGIN=

# Snapshot papkasi (standart: server/data/snapshots). Deploy'da volume yoki
# serverless'da /tmp bo'lsa — shu yerga yozing:
# SNAPSHOTS_DIR=/data/snapshots
SNAPSHOTS_DIR=
