# ============================================================================
# Google Ads API integratsiyasi — namunaviy environment (Variant A: pull+commit)
# Bu faylni .env deb nomlab ko'chiring va maxfiy qiymatlarni to'ldiring.
# .env gitignore'da — hech qachon commit qilmang!
#
# To'liq qo'llanma: docs/google-ads-api-setup.md
# ============================================================================

# 1-qadam: Google Cloud Console → OAuth client (docs 1-qadam)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# 2-qadam: MCC → API Center → developer token (docs 2-qadam)
# Dastlab "Test access"; real hisob uchun Google tasdiqlashi kerak.
GOOGLE_ADS_DEVELOPER_TOKEN=

# 3-qadam: OAuth ruxsat → refresh token (pnpm google:oauth)
GOOGLE_ADS_REFRESH_TOKEN=

# Menedjer (MCC) customer id — "login-customer-id". Raqamlarsiz (123-456-7890 → 1234567890)
GOOGLE_ADS_MANAGER_ID=

# Analitika kerak bo'lgan customer id(lar), vergul bilan:
GOOGLE_ADS_CUSTOMER_IDS=

# Test rejimda true — shunda faqat test MCC ishlaydi (token tasdiqlanmasa ham)
GOOGLE_ADS_USE_TEST_ACCOUNT=false

# (Ixtiyoriy)
GOOGLE_ADS_DATE_RANGE=LAST_30_DAYS
GOOGLE_ADS_CURRENCY=USD
# GOOGLE_ADS_API_VERSION=v25

# ============================================================================
# Real-time sync dvigateli (server rejimi: Railway/Render/VPS yoki pnpm dev)
# ============================================================================

# Meta Ads — Graph API'dan to'g'ridan-to'g'ri tortish (MCP eksporti shart emas)
# Token: Meta Business Settings → System User → ads_read huquqi bilan
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=            # act_... yoki faqat raqamlar
META_DAYS=30                   # qancha kunlik davr (default 30)

# Telegram — TGStat API (kanal statistikasi)
TGSTAT_TOKEN=

# Sync intervali (sekundda, minimum 30). Default 300 = 5 daqiqa
SYNC_INTERVAL_SEC=300

# Valyutalar (umumiy hisobda ko'rsatiladi)
AMOCRM_CURRENCY=UZS
OFFLINE_CURRENCY=UZS
TELEGRAM_CURRENCY=UZS

# ============================================================================
# Xavfsizlik (ixtiyoriy, lekin ochiq URL'da deploy qilsangiz — tavsiya etiladi)
# ============================================================================

# Dashboard paroli — qo'yilganda butun /api/* parol ostiga o'tadi (login ekrani).
# Bo'sh qoldirilsa: parol himoyasi o'chiriq (lokal dev uchun qulay).
DASHBOARD_PASSWORD=

# Sessiya imzosi uchun maxfiy kalit (random satr). Berilmasa paroldan hosil qilinadi —
# parol o'zgarsa barcha sessiyalar tugaydi.
AUTH_SECRET=

# AmoCRM webhook maxfiy kaliti — qo'yilganda webhook faqat ?secret=... bilan qabul qilinadi:
#   https://<host>/api/webhooks/amocrm?secret=<shu qiymat>
WEBHOOK_SECRET=
